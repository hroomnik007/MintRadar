# MintRadar Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (used by pg Pool in db.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/mintradar

# Port the Express server listens on (default: 3002)
PORT=3002

# Node environment — set to "production" in prod to suppress debug logs
# and restrict CORS to the live origin only
NODE_ENV=production

# Comma-separated list of allowed CORS origins
# Dev default: https://mintradar.pedani.eu,http://localhost:5173
# Prod default: https://mintradar.pedani.eu
ALLOWED_ORIGINS=https://mintradar.pedani.eu
