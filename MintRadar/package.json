{
  "name": "mintradar",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "keywords": [
    "cashu",
    "bitcoin",
    "nostr",
    "ecash",
    "lightning",
    "mint-monitoring"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint src e2e && node scripts/check-internal-links.mjs && node scripts/check-lockfile-libc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.12.0",
    "@tanstack/react-query": "^5.104.5",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "nostr-tools": "^2.25.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
