{
  "name": "mintradar",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "cashu",
    "bitcoin",
    "nostr",
    "ecash",
    "lightning",
    "mint-monitoring"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
