    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "immer": "^10.1.1",
    "lucide-react": "^1.18.0",
    "nostr-tools": "^2.7.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
